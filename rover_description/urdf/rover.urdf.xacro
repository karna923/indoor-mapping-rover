<?xml version="1.0"?>
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ===================== Measured dimensions ===================== -->
  <xacro:property name="base_length" value="0.300"/>
  <xacro:property name="base_width"  value="0.250"/>
  <xacro:property name="base_thickness" value="0.005"/>
  <xacro:property name="ground_clearance" value="0.025"/>
  <xacro:property name="wheel_radius" value="0.0425"/>
  <xacro:property name="wheel_thickness" value="0.026"/>
  <xacro:property name="wheel_separation" value="0.180"/>
  <xacro:property name="wheel_axle_x" value="-0.085"/>
  <xacro:property name="caster_offset_x_from_axle" value="0.210"/>
  <xacro:property name="caster_x" value="${wheel_axle_x + caster_offset_x_from_axle}"/>
  <xacro:property name="sensor_offset_x" value="0.150"/>
  <xacro:property name="sensor_offset_z" value="0.0425"/>
  <xacro:property name="base_link_z" value="${ground_clearance + base_thickness/2}"/>
  <xacro:property name="wheel_z" value="${wheel_radius - base_link_z}"/>
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>
  <xacro:property name="base_mesh_rpy" value = "1.5708 0 0"/>
  <xacro:property name="lidar_offset_x" value="0.0"/>
  <xacro:property name="lidar_offset_y" value="0.0"/>
  <xacro:property name="lidar_offset_z" value="0.08"/>



  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.150 0.125 0" rpy="${base_mesh_rpy}"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/base_plate.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0.235 0.215 -0.024" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/wheel_left.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="${wheel_axle_x} ${wheel_separation/2} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="20.0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0.235 0.035 -0.024" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/wheel_right.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="${wheel_axle_x} ${-wheel_separation/2} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="20.0"/>
  </joint>

  <link name="caster_link">
    <visual>
    <origin xyz="0.025 0.125 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/caster_body.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <visual>
    <origin xyz="0.025 0.125 0.001602" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/caster_ball.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.010"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="sensor_link"/>
  <joint name="sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_link"/>
    <origin xyz="${sensor_offset_x} 0 ${sensor_offset_z}" rpy="0 0 0"/>
  </joint>


  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_offset_x} ${lidar_offset_y} ${lidar_offset_z}" rpy="0 0 0"/>
  </joint>


<!-- ===================== Gazebo materials ===================== -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="caster_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <ros2_control name="RoverSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>


  
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find rover_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
