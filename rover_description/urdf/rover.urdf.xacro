<?xml version="1.0"?>
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ===================== Measured dimensions ===================== -->
  <xacro:property name="base_length" value="0.300"/>
  <xacro:property name="base_width"  value="0.250"/>
  <xacro:property name="base_thickness" value="0.100"/>
  <xacro:property name="base_height" value="${base_thickness}"/>
  <xacro:property name="base_collision_z" value="${base_height/2}"/>
  <xacro:property name="ground_clearance" value="0.0156"/>
  <xacro:property name="caster_visual_rpy" value="-1.5708 0 0"/>
  <xacro:property name="caster_ground_reach" value="0.0156"/>
  <xacro:property name="caster_ball_radius" value="0.007"/>
  <xacro:property name="wheel_radius" value="0.0425"/>
  <xacro:property name="wheel_thickness" value="0.026"/>
  <xacro:property name="wheel_separation" value="0.235"/>
  <xacro:property name="wheel_axle_x" value="0.050"/>
  <xacro:property name="caster_offset_x_from_axle" value="-0.175"/>
  <xacro:property name="caster_x" value="${wheel_axle_x + caster_offset_x_from_axle}"/>
  <xacro:property name="sensor_offset_x" value="0.150"/>
  <xacro:property name="sensor_offset_z" value="0.0425"/>
  <xacro:property name="base_link_z" value="${ground_clearance}"/>
  <xacro:property name="base_visual_x" value="0.150"/>
  <xacro:property name="base_visual_y" value="0.125"/>
  <xacro:property name="base_visual_z" value="0.005"/>
  <xacro:property name="wheel_z" value="${wheel_radius - base_link_z}"/>
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>
  <xacro:property name="base_mesh_rpy" value = "1.5708 0 0"/>
  <xacro:property name="lidar_offset_x" value="0.0"/>
  <xacro:property name="lidar_offset_y" value="0.0"/>
  <xacro:property name="lidar_offset_z" value="0.100"/>



  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="${base_visual_x} ${base_visual_y} ${base_visual_z}" rpy="${base_mesh_rpy}"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/base_plate.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_collision_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 -0.013 0" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/wheel.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="${wheel_axle_x} ${wheel_separation/2} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="20.0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 -0.013 0" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/wheel.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="${wheel_axle_x} ${-wheel_separation/2} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10.0" velocity="20.0"/>
  </joint>

  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="${caster_visual_rpy}"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/caster.stl" scale="${mesh_scale}"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${-caster_ground_reach + caster_ball_radius}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_ball_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="sensor_link"/>
  <joint name="sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_link"/>
    <origin xyz="${sensor_offset_x} 0 ${sensor_offset_z}" rpy="0 0 0"/>
  </joint>


  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.02" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>


  <link name="imu_link">
    <visual>
    <geometry>
      <box size="0.02 0.02 0.01"/>
    </geometry>
    <material name="green">
      <color rgba="0 0.6 0 1"/>
    </material>
  </visual>
  <collision>
    <geometry>
      <box size="0.02 0.02 0.01"/>
    </geometry>
  </collision>
  <inertial>
    <mass value="0.01"/>
    <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
  </inertial>
</link>

<joint name="imu_joint" type="fixed">
  <parent link="base_link"/>
  <child link="imu_link"/>
  <origin xyz="0 0 0.100" rpy="0 0 0"/>
</joint>

<gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <visualize>false</visualize>
    <topic>imu</topic>
    <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0009</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0009</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0009</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.004</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.004</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.004</stddev></noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>


  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_offset_x} ${lidar_offset_y} ${lidar_offset_z}" rpy="0 0 0"/>
  </joint>


<!-- ===================== Gazebo materials ===================== -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="caster_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <ros2_control name="RoverSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>


  
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find rover_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>


  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>ground_truth_odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/model/rover/odometry_ground_truth</odom_topic>
      <odom_publish_frequency>100</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>
</robot>